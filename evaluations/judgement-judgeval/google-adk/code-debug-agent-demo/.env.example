# Google API Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=false

# Stack Exchange API (optional, for higher rate limits)
STACKEXCHANGE_API_KEY=your_stackexchange_api_key_here

# JudgmentLabs Configuration
JUDGMENT_API_KEY=your_judgment_api_key_here
JUDGMENT_ORG_ID=your_org_id_here

# Langfuse Configuration (optional, for observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith Configuration (optional, for observability)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=code-debug-agent-eval

# Evaluation Configuration
EVAL_OUTPUT_DIR=./eval_results
EVAL_SAMPLING_RATE=1.0
