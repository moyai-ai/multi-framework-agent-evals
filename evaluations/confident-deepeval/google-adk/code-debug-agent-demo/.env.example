# Google Gemini API Key (REQUIRED)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Stack Exchange API Key (OPTIONAL)
# Get your key from: https://stackapps.com/apps/oauth/register
# Used for higher search quotas when debugging code errors
STACKEXCHANGE_KEY=your_stackexchange_key_here

# DeepEval / OpenAI (OPTIONAL)
# Some DeepEval metrics may use OpenAI models for evaluation
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Langfuse Observability (OPTIONAL)
# Get your keys from: https://cloud.langfuse.com/
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith Observability (OPTIONAL)
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=your_project_name_here

CONFIDENT_API_KEY=your_confident_api_key_here
